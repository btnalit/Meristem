{
  "id": "failure-aggregator",
  "version": "1",
  "capability": "Query journal entries to detect repeated rejections for the same failure class, classify them, and append structured entries to state/patterns.md",
  "entrypoint": ["python3", "main.py"],
  "input_schema": {"op": "string", "journal_path": "string", "repo_path": "string", "cycle": "integer"},
  "output_schema": {"signals": "array", "patterns_written": "array"},
  "dependencies": [],
  "probes": [],
  "metrics": ["usage", "success_rate", "patterns_detected"],
  "lifecycle": "candidate"
}
