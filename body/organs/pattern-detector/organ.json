{
  "id": "pattern-detector",
  "version": "1",
  "capability": "Detects failure classes from journal rejection data and appends new P-NNN entries to state/patterns.md",
  "entrypoint": ["python3", "main.py"],
  "input_schema": {
    "op": "string (detect or selfcheck)",
    "journal_path": "string",
    "repo_path": "string",
    "cycle": "integer"
  },
  "output_schema": {
    "ok": "boolean",
    "patterns_written": "array of strings",
    "classes_detected": "array of objects",
    "skipped_known": "array of strings",
    "skipped_low_count": "array of strings"
  },
  "dependencies": [],
  "probes": ["probe-pattern-detector-basic"],
  "metrics": ["usage", "success_rate", "patterns_written"],
  "lifecycle": "candidate"
}