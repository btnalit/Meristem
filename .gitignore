__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# The eval vault must NEVER be committed. Rubrics and held-outs are invisible
# to the mutation engine by construction; if they ever appear here that is a
# constitutional violation, not a convenience.
meristem-vault/
eval-vault/

# Transient worktrees created per mutation cycle.
meristem-wt-*/
meristem-canary/

# Runtime records are PER-DEPLOYMENT state, not source. The constitution
# forbids deleting or rewriting them; that is satisfied by their living
# append-only on the deployment's disk. Committing them would dirty the tree
# every cycle, conflict between deployments, and publish operational traces.
#
# v5: state/ holds ONLY the soil-owned ledgers (state/soil-*.jsonl, spec 8.1.5),
# so the whole directory is runtime. Soil creates it at startup. It is
# deliberately NOT tracked with a .gitkeep: CA-8 asserts that every file under
# state/ matches ^state/soil-[a-z0-9-]+\.jsonl$, and a placeholder would need an
# exception carved into that assertion -- which is how enumerated boundaries leak.
# v3.1's .md registers (patterns, gaps, backlog) no longer exist.
state/

.env
*.tmp

# Generated report
REPORT.md

# v5: 晋升锁是运行时文件，不是源码。刻意不放在 state/ —— CA-8 断言 state/ 下
# 每个文件都匹配 ^state/soil-[a-z0-9-]+\.jsonl$，给锁文件开一条例外，
# 正是列举式边界漏水的方式（同 .gitkeep 那次的理由）。
soil/.promotion.lock
soil/runtime-manifest.json
soil/report-facts.json
soil/frozen-probe-registry.json
seed/feedback.json
