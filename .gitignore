__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# The eval vault must NEVER be committed. Rubrics and held-outs are invisible
# to the mutation engine by construction; if they ever appear here that is a
# constitutional violation, not a convenience.
meristem-vault/
eval-vault/

# Transient worktrees created per mutation cycle.
meristem-wt-*/
meristem-canary/

# Runtime records are PER-DEPLOYMENT state, not source. The constitution
# forbids deleting or rewriting them; that is satisfied by their living
# append-only on the deployment's disk. Committing them would dirty the tree
# every cycle, conflict between deployments, and publish operational traces.
# The .md registers (patterns, gaps, backlog) ARE knowledge and stay tracked.
state/*.jsonl

.env
*.tmp
